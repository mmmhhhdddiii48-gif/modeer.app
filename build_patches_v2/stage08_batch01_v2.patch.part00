diff --git a/mobile/generators_mobile/lib/features/domain/data/domain_repository.dart b/mobile/generators_mobile/lib/features/domain/data/domain_repository.dart
index 17135eb..3f7b3bd 100644
--- a/mobile/generators_mobile/lib/features/domain/data/domain_repository.dart
+++ b/mobile/generators_mobile/lib/features/domain/data/domain_repository.dart
@@ -92,12 +92,14 @@ final class DomainRepository {
   }
 
   Future<GeneratorSubscriber> saveSubscriber({
+    required String tenantId,
     String? id,
     required Map<String, dynamic> input,
   }) async {
     final data = id == null
         ? await _api.createOwnerSubscriber(input)
         : await _api.updateOwnerSubscriber(id, input);
+    await _upsertSubscriberCache(tenantId, data);
     return GeneratorSubscriber.fromApi(data);
   }
 
@@ -129,6 +131,48 @@ final class DomainRepository {
     return AssignedDomain.fromApi(data);
   }
 
+  Future<void> _upsertSubscriberCache(
+    String tenantId,
+    Map<String, dynamic> subscriber,
+  ) async {
+    final key = 'stage03.domain.subscribers.$tenantId';
+    final cached = await _database.getMeta(key);
+    if (cached == null || cached.isEmpty) return;
+
+    try {
+      final data = Map<String, dynamic>.from(jsonDecode(cached) as Map);
+      final subscribers = (data['subscribers'] as List? ?? const [])
+          .whereType<Map>()
+          .map((item) => Map<String, dynamic>.from(item))
+          .toList(growable: true);
+      final index = subscribers.indexWhere((item) => item['id'] == subscriber['id']);
+      final isNew = index < 0;
+      if (isNew) {
+        subscribers.add(Map<String, dynamic>.from(subscriber));
+      } else {
+        subscribers[index] = Map<String, dynamic>.from(subscriber);
+      }
+      subscribers.sort((a, b) {
+        final aActive = a['status'] == 'active' ? 0 : 1;
+        final bActive = b['status'] == 'active' ? 0 : 1;
+        if (aActive != bActive) return aActive.compareTo(bActive);
+        return (a['full_name']?.toString() ?? '')
+            .compareTo(b['full_name']?.toString() ?? '');
+      });
+      data['subscribers'] = subscribers;
+      if (isNew && data['summary'] is Map) {
+        final summary = Map<String, dynamic>.from(data['summary'] as Map);
+        final total = summary['subscribers_total'];
+        summary['subscribers_total'] =
+            (total is num ? total.toInt() : int.tryParse(total?.toString() ?? '') ?? 0) + 1;
+        data['summary'] = summary;
+      }
+      await _database.setMeta(key, jsonEncode(data));
+    } catch (_) {
+      // A corrupt optional cache must never block a successful server save.
+    }
+  }
+
   Future<Map<String, dynamic>> _loadCached({
     required String key,
     required Future<Map<String, dynamic>> Function() remote,

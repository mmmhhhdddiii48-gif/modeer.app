+        tenantId: widget.tenantId,
+        id: current?.id,
+        input: input,
+      );
+      if (!mounted) return;
+      setState(() {
+        final updated = _items.toList(growable: true);
+        final index = updated.indexWhere((item) => item.id == saved.id);
+        if (index < 0) {
+          updated.add(saved);
+        } else {
+          updated[index] = saved;
+        }
+        updated.sort((a, b) {
+          final aActive = a.isActive ? 0 : 1;
+          final bActive = b.isActive ? 0 : 1;
+          if (aActive != bActive) return aActive.compareTo(bActive);
+          return a.fullName.compareTo(b.fullName);
+        });
+        _items = List.unmodifiable(updated);
+      });
+      _message(context, current == null ? 'تمت إضافة المشترك وظهر مباشرة.' : 'تم تعديل المشترك.');
     } on DioException catch (error) {
       _message(context, _apiMessage(error));
     }

+        now: now,
+      );
+
+  MonthlyPeriod applyPaymentAmount(int amountIqd) {
+    final applied = amountIqd.clamp(0, remainingIqd).toInt();
+    return MonthlyPeriod(
+      id: id,
+      periodKey: periodKey,
+      title: title,
+      status: status,
+      readingCount: readingCount,
+      priceCount: priceCount,
+      invoiceCount: invoiceCount,
+      totalIqd: totalIqd,
+      paidIqd: paidIqd + applied,
+      remainingIqd: remainingIqd - applied,
+    );
+  }
 }
 

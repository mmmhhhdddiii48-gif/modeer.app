--- a/mobile/generators_mobile/lib/features/simple_billing/domain/simple_billing_models.dart
+++ b/mobile/generators_mobile/lib/features/simple_billing/domain/simple_billing_models.dart
@@ -1,3 +1,33 @@
+enum BillingDueState { settled, dueNow, overdue, upcoming }
+
+extension BillingDueStateLabel on BillingDueState {
+  String get label => switch (this) {
+        BillingDueState.settled => 'مسدد',
+        BillingDueState.dueNow => 'مستحق الآن',
+        BillingDueState.overdue => 'متأخر',
+        BillingDueState.upcoming => 'غير مستحق بعد',
+      };
+}
+
+String _monthKey(DateTime value) =>
+    '${value.year.toString().padLeft(4, '0')}-${value.month.toString().padLeft(2, '0')}';
+
+BillingDueState _dueState({
+  required String? periodKey,
+  required int remainingIqd,
+  required DateTime now,
+}) {
+  if (remainingIqd <= 0) return BillingDueState.settled;
+  final key = periodKey == null || periodKey.length < 7
+      ? null
+      : periodKey.substring(0, 7);
+  if (key == null) return BillingDueState.dueNow;
+  final current = _monthKey(now);
+  if (key.compareTo(current) < 0) return BillingDueState.overdue;
+  if (key == current) return BillingDueState.dueNow;
+  return BillingDueState.upcoming;
+}
+

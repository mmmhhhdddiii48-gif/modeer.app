+import 'package:flutter_test/flutter_test.dart';
+import 'package:nukhba_generators_mobile/features/simple_billing/domain/simple_billing_models.dart';
+
+void main() {
+  test('workspace parses pending subscriber without adding invoice debt', () {
+    final workspace = MonthlyWorkspace.fromJson({
+      'period': {'id': 'period-1', 'period_key': '2026-07'},
+      'generators': const [],
+      'invoices': const [],
+      'pending_subscribers': [
+        {
+          'id': 'subscriber-1',
+          'account_number': 'A-1',
+          'full_name': 'مشترك جديد',
+          'generator_name': 'مولدة',
+          'contracted_amperes': 5,
+          'has_reading': false,
+        },
+      ],
+      'summary': {'total_iqd': 0, 'remaining_iqd': 0},
+    });
+
+    expect(workspace.invoices, isEmpty);
+    expect(workspace.summary.totalIqd, 0);
+    expect(workspace.pendingSubscribers.single.fullName, 'مشترك جديد');
+    expect(
+      workspace.pendingSubscribers.single.billingStateLabel,
+      'بانتظار قراءة العداد',
+    );
+  });
+
+  test('owner payment result updates remaining and summary locally', () {
+    final workspace = MonthlyWorkspace.fromJson({
+      'period': {'id': 'period-1', 'period_key': '2026-07'},
+      'generators': const [],

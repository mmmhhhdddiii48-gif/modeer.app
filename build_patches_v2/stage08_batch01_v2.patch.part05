+          'invoice_number': 'INV-1',
+          'status': 'unpaid',
+          'subscriber_name': 'مشترك',
+          'account_number': 'A-1',
+          'generator_name': 'مولدة',
+          'contracted_amperes': 10,
+          'price_per_amp_iqd': 10000,
+          'fixed_fee_iqd': 0,
+          'amount_iqd': 100000,
+          'paid_amount_iqd': 0,

+final class _PaymentAlertsCard extends StatelessWidget {
+  const _PaymentAlertsCard({required this.periods, required this.now});
+
+  final List<MonthlyPeriod> periods;
+  final DateTime now;
+
+  @override
+  Widget build(BuildContext context) {
+    final overdue = periods
+        .where((period) => period.dueStateAt(now) == BillingDueState.overdue)
+        .toList(growable: false);
+    final dueNow = periods
+        .where((period) => period.dueStateAt(now) == BillingDueState.dueNow)
+        .toList(growable: false);
+    final overdueAmount = overdue.fold<int>(
+      0,
+      (total, period) => total + period.remainingIqd,
+    );
+    final dueAmount = dueNow.fold<int>(
+      0,
+      (total, period) => total + period.remainingIqd,
+    );
+    final hasOverdue = overdueAmount > 0;
+    final hasDue = dueAmount > 0;
+    final color = hasOverdue
+        ? Colors.redAccent
+        : hasDue
+            ? AppTheme.orange
+            : AppTheme.teal;
+    final title = hasOverdue
+        ? 'تنبيه: توجد مبالغ متأخرة'
+        : hasDue
+            ? 'تنبيه استحقاق الشهر الحالي'
+            : 'لا توجد استحقاقات غير مسددة';
+    final details = hasOverdue
+        ? '${overdue.length} شهر متأخر • ${_money(overdueAmount)} د.ع'
+            '${hasDue ? '\nالشهر الحالي: ${_money(dueAmount)} د.ع' : ''}'
+        : hasDue
+            ? '${dueNow.length} شهر مستحق • ${_money(dueAmount)} د.ع'
+            : 'جميع الأشهر المسجلة مسددة حتى الآن.';
+    return Container(
+      padding: const EdgeInsets.all(14),
+      decoration: BoxDecoration(
+        color: color.withValues(alpha: 0.12),
+        borderRadius: BorderRadius.circular(16),
+        border: Border.all(color: color.withValues(alpha: 0.60)),
+      ),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Icon(
+            hasOverdue
+                ? Icons.warning_amber_rounded
+                : hasDue
+                    ? Icons.notifications_active_outlined
+                    : Icons.check_circle_outline,
+            color: color,
+          ),
+          const SizedBox(width: 10),
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(title, style: const TextStyle(fontWeight: FontWeight.w900)),
+                const SizedBox(height: 4),
+                Text(details),
+              ],
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}

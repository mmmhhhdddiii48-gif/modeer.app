'summary'] as Map? ?? const {})),
       );
 
   final MonthlyPeriod period;
   final List<MonthlyGeneratorPrice> generators;
   final List<MonthlyInvoice> invoices;
+  final List<PendingBillingSubscriber> pendingSubscribers;
   final MonthlySummary summary;
+
+  MonthlyWorkspace applyPayment(OwnerPaymentResult result) {
+    final index = invoices.indexWhere((item) => item.id == result.invoiceId);
+    if (index < 0) return this;
+    final before = invoices[index];
+    final after = before.applyPayment(result);
+    final updatedInvoices = invoices.toList(growable: true)..[index] = after;
+    return MonthlyWorkspace(
+      period: period,
+      generators: generators,
+      invoices: List.unmodifiable(updatedInvoices),
+      pendingSubscribers: pendingSubscribers,
+      summary: summary.applyPayment(before: before, after: after),
+    );
+  }
+}
+
+final class OwnerPaymentResult {
+  const OwnerPaymentResult({
+    required this.payment,
+    required this.invoiceId,
+    required this.paidAmountIqd,
+    required this.remainingAmountIqd,
+    required this.status,
+    required this.duplicate,
+    this.lastPaymentAt,
+  });
+
+  factory OwnerPaymentResult.fromJson(Map<String, dynamic> json) {
+    final invoice = Map<String, dynamic>.from(json['invoice'] as Map? ?? const {});
+    return OwnerPaymentResult(
+      payment: InvoicePayment.fromJson(
+        Map<String, dynamic>.from(json['payment'] as Map? ?? const {}),
+      ),
+      invoiceId: invoice['id']?.toString() ?? '',
+      paidAmountIqd: _int(invoice['paid_amount_iqd']),
+      remainingAmountIqd: _int(invoice['remaining_amount_iqd']),
+      status: invoice['status']?.toString() ?? 'unpaid',
+      lastPaymentAt: invoice['last_payment_at']?.toString(),
+      duplicate: json['duplicate'] == true,
+    );
+  }
+
+  final InvoicePayment payment;
+  final String invoiceId;
+  final int paidAmountIqd;
+  final int remainingAmountIqd;
+  final String status;
+  final String? lastPaymentAt;
+  final bool duplicate;
 }
 

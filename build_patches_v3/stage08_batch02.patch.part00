+  InvoiceDueState dueStateAt(DateTime now) {
+    if (remainingIqd <= 0) return InvoiceDueState.settled;
+    final parts = periodKey.split('-');
+    if (parts.length != 2) return InvoiceDueState.dueNow;
+    final year = int.tryParse(parts[0]);
+    final month = int.tryParse(parts[1]);
+    if (year == null || month == null || month < 1 || month > 12) {
+      return InvoiceDueState.dueNow;
+    }
+    final periodStart = DateTime(year, month);
+    final currentMonth = DateTime(now.year, now.month);
+    if (periodStart.isBefore(currentMonth)) return InvoiceDueState.overdue;
+    if (periodStart.isAfter(currentMonth)) return InvoiceDueState.upcoming;
+    return InvoiceDueState.dueNow;
+  }
 }
 

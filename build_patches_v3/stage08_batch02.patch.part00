diff --git a/STAGE08_BATCH02_REPORT.txt b/STAGE08_BATCH02_REPORT.txt
new file mode 100644
index 0000000..bdae944
--- /dev/null
+++ b/STAGE08_BATCH02_REPORT.txt
@@ -0,0 +1,27 @@
+Nukhba Generators — Stage08 Batch02 Report
+
+Accepted base:
+- Nukhba Generators Stage08 Batch01 accepted by the owner.
+- This batch keeps the existing calculations, server URL, storage, authentication, and collector restrictions unchanged.
+
+Exactly three implemented changes:
+1. Added clear edit buttons to generator, route, and subscriber cards that need editing.
+2. Displayed subscriber creation date and invoice/payment date and time from the server's existing created_at fields.
+3. Added visible payment alerts that distinguish current-month dues from unpaid invoices belonging to older months.
+
+Important boundaries:
+- No Render deployment or backend schema change.
+- No printing, PDF, activation, login, branding, generator load, or collector APK work.
+- No invented due day. Current month is classified as due now; older unpaid months are overdue.
+- No accounting formulas, payment validation, invoice totals, or remaining balance calculations were changed.
+
+Verification:
+- Explicit edit buttons are present and call the existing edit dialogs.
+- Subscriber creation dates use the server created_at field.
+- Payment and invoice timestamps use the server created_at field.
+- Current-month unpaid invoices are labelled due now.
+- Older unpaid invoices are labelled overdue.
+- Paid invoices are excluded from due and overdue counts.
+
+Delivery gate:
+- Stop after this batch and wait for owner manual acceptance.
diff --git a/mobile/generators_mobile/lib/core/formatters/date_time_formatter.dart b/mobile/generators_mobile/lib/core/formatters/date_time_formatter.dart
new file mode 100644
index 0000000..a43f841
--- /dev/null
+++ b/mobile/generators_mobile/lib/core/formatters/date_time_formatter.dart
@@ -0,0 +1,44 @@
+String formatAppDateTime(String? raw) {
+  final value = _parseDateTime(raw);
+  if (value == null) return 'غير متوفر';
+  final local = value.toLocal();
+  return '${_two(local.day)}/${_two(local.month)}/${local.year} '
+      '${_two(local.hour)}:${_two(local.minute)}';
+}
+
+String formatAppDate(String? raw) {
+  final value = _parseDateTime(raw);
+  if (value == null) return 'غير متوفر';
+  final local = value.toLocal();
+  return '${_two(local.day)}/${_two(local.month)}/${local.year}';
+}
+
+DateTime? _parseDateTime(String? raw) {
+  final trimmed = raw?.trim();
+  if (trimmed == null || trimmed.isEmpty) return null;
+  return DateTime.tryParse(trimmed);
+}
+
+String _two(int value) => value.toString().padLeft(2, '0');

{
  "name": "nukhba-api-backend",
  "version": "1.0.0",
  "description": "Nukhba Backend API - GitHub and Render deploy-ready build.",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check:db": "node scripts/check-db.js",
    "db:init": "node scripts/init-db.js",
    "seed:agent": "node scripts/seed-agent.js",
    "seed:generators": "node scripts/seed-generators-stage01.js",
    "test:generators:stage01": "node --test tests/generators_stage01.test.js",
    "test:generators:stage02": "node --test tests/generators_stage02.test.js",
    "test:generators:stage02:contract": "node --test tests/generators_stage02_contract.test.js",
    "test:generators:stage03": "node --test tests/generators_stage03.test.js",
    "test:generators:stage03:contract": "node --test tests/generators_stage03_contract.test.js",
    "test:generators:stage04": "node --test tests/generators_stage04.test.js",
    "test:generators:stage04:contract": "node --test tests/generators_stage04_contract.test.js",
    "test:generators": "node --test tests/generators_stage01.test.js tests/generators_stage02.test.js tests/generators_stage02_contract.test.js tests/generators_stage03.test.js tests/generators_stage03_contract.test.js tests/generators_stage04.test.js tests/generators_stage04_contract.test.js",
    "render:check": "node scripts/check-db.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0"
  }
}
